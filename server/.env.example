# Copy to server/.env (gitignored). Re-read on every request; no restart needed.
# Values here take precedence over the process environment.

# LLM provider: 'demo' (default, deterministic, no LLM calls) or 'runware'
LLM_PROVIDER=demo
RUNWARE_API_KEY=
RUNWARE_MODEL=minimax:m3@0   # measured faster: openai:gpt@5
# RUNWARE_BASE_URL is for tests only (points at scripts/mock-llm.mjs); leave unset in real use.

# Telem role-context retrieval (used by server/telem.ts)
TELEM_API_KEY=
